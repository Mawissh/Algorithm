function I_UV = UV_permutation(I)
% ------------------------------------------------------------
% Forward intensity bit-plane permutation (U + V)
% Input : I   - 512x512 uint8 grayscale image
% Output: I_UV - permuted image
% ------------------------------------------------------------

I = uint8(I);

% --- Extract bit-planes ---
bits = zeros(512,512,8,'uint8');
for k = 1:8
    bits(:,:,k) = uint8(bitget(I,k));
end

c0 = bits(:,:,1); c1 = bits(:,:,2); c2 = bits(:,:,3); c3 = bits(:,:,4);
c4 = bits(:,:,5); c5 = bits(:,:,6); c6 = bits(:,:,7); c7 = bits(:,:,8);

% --- XNOR helper ---
xnor4 = @(a,b,c,d) uint8(~xor(xor(a,b), xor(c,d)));

% --- Forward V (as in your paper) ---
cp0 = xnor4(c5, c6, c7, c4);
cp1 = xnor4(c4, c1, c6, c7);
cp2 = xnor4(c7, c0, c1, c6);
cp3 = xnor4(c6, c3, c0, c1);
cp4 = xnor4(c1, c2, c3, c0);

cp5 = xnor4(c0, cp0, c2, c3);
cp6 = xnor4(c3, cp1, cp0, c2);
cp7 = xnor4(c2, cp2, cp1, cp0);

% --- Reconstruct image ---
I_UV = zeros(512,512,'uint8');
I_UV = bitset(I_UV,1,cp0);
I_UV = bitset(I_UV,2,cp1);
I_UV = bitset(I_UV,3,cp2);
I_UV = bitset(I_UV,4,cp3);
I_UV = bitset(I_UV,5,cp4);
I_UV = bitset(I_UV,6,cp5);
I_UV = bitset(I_UV,7,cp6);
I_UV = bitset(I_UV,8,cp7);

end
